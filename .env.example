# Copy to .env and fill in the key for the backend you want to use.
# The app auto-detects which cloud key is present, in this order:
#   OpenAI -> Google -> Groq -> Ollama -> offline stub
# Every variable below is read exactly as named here; see src/generate.py
# (get_generator, FORCED_MODELS) for the resolution order and the defaults.

# --- Cloud generators -------------------------------------------------------
# Only one key is needed. The first one found above is the one that is used, so
# leaving a second key filled in has no effect rather than mixing providers.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# NOTE: the variable is GOOGLE_MODEL, not GEMINI_MODEL. The code has always read
# GOOGLE_MODEL (src/generate.py), so a .env carrying GEMINI_MODEL silently fell
# back to the built-in default model instead of the one you chose.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini/gemini-1.5-flash

# This is the backend this project is currently configured against.
GROQ_API_KEY=
# LiteLLM model string - the "groq/" prefix is required and must not be doubled
# up with the provider prefix; LiteLLM resolves it to "groq:groq/...".
GROQ_MODEL=groq/openai/gpt-oss-120b

# --- Local generator --------------------------------------------------------
# OLLAMA_MODEL doubles as the opt-in switch: it is only used when set, so an unset
# value never probes a local daemon and never adds a connection timeout to a run
# that does not want one. The daemon is expected at http://localhost:11434, which
# is where LiteLLM connects; it is not configurable via this project.
OLLAMA_MODEL=llama3.1

# Force a backend instead of auto-detecting. One of:
#   openai | gemini | groq | ollama | stub
# Any other value is passed through to LiteLLM as a raw model id, so a
# provider-less route stays reachable. "stub" runs the offline extractive
# generator, which cannot invent and never calls the network.
GENERATOR_BACKEND=

# Diagnostics: set to 1 to print which backend was resolved. Off by default,
# because get_generator() runs on every question and the line is noise in the UI.
GENERATOR_VERBOSE=
